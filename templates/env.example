# ~/.config/ai-agents/env — overrides for the ai-agents wrappers (sourced by lib.sh)
# Gemini via Antigravity CLI (agy, Google account). List models: agy models
#GEMINI_MODEL_SIMPLE=gemini-3.8-flash-medium
#GEMINI_MODEL_NORMAL=gemini-3.8-flash-high
#GEMINI_MODEL_COMPLEX=gemini-3.8-flash-high
#GEMINI_MODEL_IMAGE=gemini-3.8-flash-medium
# Cursor CLI (agent). Empty = newest composer model. List: agent --list-models
#CURSOR_MODEL=
# Optional: impeccable design detector path (auto-detected under ~/.agents/skills)
#IMPECCABLE_BIN=
