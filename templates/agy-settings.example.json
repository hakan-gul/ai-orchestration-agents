{
  "permissions": {
    "allow": [
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(grep)",
      "command(rg)",
      "command(find)",
      "command(tree)",
      "command(pwd)",
      "command(diff)",
      "command(sed -n)",
      "command(awk)",
      "command(sort)",
      "command(echo)",
      "command(mkdir)",
      "command(touch)",
      "command(node)",
      "command(npm run)",
      "command(npm test)",
      "command(npx tsc)",
      "command(npx eslint)",
      "command(npx prettier)",
      "command(npx vitest)",
      "command(npx jest)",
      "command(php -l)",
      "command(php artisan test)",
      "command(php artisan route:list)",
      "command(vendor/bin/phpunit)",
      "command(vendor/bin/pint)",
      "command(composer dump-autoload)",
      "command(python3)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "read_file({{PROJECTS_DIR}})",
      "write_file({{PROJECTS_DIR}})",
      "read_file(/tmp)",
      "write_file(/tmp)"
    ],
    "deny": [
      "command(sudo)",
      "command(rm -rf /)",
      "command(systemctl)",
      "command(service)",
      "command(nginx)",
      "command(reboot)",
      "command(shutdown)",
      "command(rsync)",
      "command(scp)",
      "command(ssh)",
      "command(git push)",
      "command(git commit)",
      "command(git reset --hard)",
      "command(chown)",
      "command(chmod)",
      "command(apt)",
      "command(npm install -g)",
      "command(pm2)",
      "command(crontab)",
      "command(mysql)",
      "command(php artisan migrate)",
      "command(php artisan db:wipe)",
      "command(curl)",
      "command(wget)",
      "write_file(/etc)",
      "write_file(/root/.ssh)",
      "write_file(.env)",
      "write_file(.git/)"
    ]
  }
}
